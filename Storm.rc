#include "resource.h"
#include <winresrc.h>

// The name Windows shows in the screen saver list. Older shells read this
// string; the version block below is what current Windows uses.
STRINGTABLE
BEGIN
    IDS_DESCRIPTION "Storm"
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION    STORM_VERSION_MAJOR,STORM_VERSION_MINOR,STORM_VERSION_PATCH,0
PRODUCTVERSION STORM_VERSION_MAJOR,STORM_VERSION_MINOR,STORM_VERSION_PATCH,0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Storm"
            VALUE "FileVersion",     STORM_VERSION_ASCII ".0"
            VALUE "InternalName",    "Storm"
            VALUE "OriginalFilename","Storm.scr"
            VALUE "ProductName",     "Storm Screen Saver"
            VALUE "ProductVersion",  STORM_VERSION_ASCII ".0"
            VALUE "Comments",        "A volumetric supercell, as a screensaver."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
